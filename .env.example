# Copy to .env.local (dev) or pass through docker-compose. Never commit keys.

# ---------------------------------------------------------------- integrations
# Also settable in the app's Settings dialog, which wins over these.
OMNIVORE_URL=
OMNIVORE_API_KEY=
MARRETA_URL=https://marreta.link
ARCHIVE_URL=https://web.archive.org/web/

# --------------------------------------------------------------------- digest
# When the daily and weekly digests are built, in DIGEST_TZ. A host that was
# asleep at the scheduled time builds on its first tick after waking.
# DIGEST_TZ defaults to the container's TZ, which is UTC — set it or your
# "morning" digest lands at the wrong hour.
DIGEST_DAILY_AT=08:00
DIGEST_WEEKLY_AT=Sun 19:00
DIGEST_TZ=Europe/Moscow

# ------------------------------------------------------------------------ llm
# Annotations for the digest. Leave LLM_PROVIDERS empty and everything still
# works — the digest falls back to the articles' own opening lines.
#
# Either a comma-separated list of names, tried in order until one answers:
#   LLM_PROVIDERS=ollama,groq
# with known presets (ollama, groq, cerebras, openrouter) supplying the URL and
# a default model, and any field overridable per provider:
#   LLM_OLLAMA_URL / _MODEL / _KEY / _TIMEOUT_MS
# Any other name works too, as long as you give it a URL and a model.
#
# Or a JSON array when you want two configs of the same provider:
#   LLM_PROVIDERS=[{"name":"local","kind":"ollama","baseUrl":"http://host.docker.internal:11434/v1","model":"qwen3:4b","timeoutMs":180000}]
#
# Local first: only the article text ever leaves the host, and only to a
# provider you list here. The taste profile and embeddings never do.
LLM_PROVIDERS=

# Some providers geo-block (Groq answers 403 from a fair few countries). Node's
# fetch ignores the usual HTTP_PROXY convention, so route the provider calls
# explicitly — nothing else in the app goes through it, and a provider on
# localhost or the LAN (your Ollama) is never proxied.
# Falls back to HTTPS_PROXY / HTTP_PROXY when unset.
# LLM_PROXY_URL=http://proxy.lan:1080

LLM_OLLAMA_URL=http://localhost:11434/v1
LLM_OLLAMA_MODEL=qwen3:4b
LLM_OLLAMA_TIMEOUT_MS=180000
# LLM_GROQ_KEY=

# Ranking is one big prompt rather than eight small ones, and token budgets are
# metered per model — so pointing this at a *different* model than
# LLM_PROVIDERS gives the rerank its own window and it never competes with the
# annotations. Falls back to LLM_PROVIDERS.
# LLM_RANK_PROVIDERS=groq-small
# LLM_GROQ_SMALL_URL=https://api.groq.com/openai/v1
# LLM_GROQ_SMALL_MODEL=llama-3.1-8b-instant
# LLM_GROQ_SMALL_KEY=

# Pacing reads the provider's own x-ratelimit-* headers. Declare a limit only
# for providers that send none (a self-hosted Ollama has no reason to).
# LLM_OLLAMA_TPM=

# Set to "off" to keep the taste-profile order and skip the ranking call.
# DIGEST_RERANK=on

# --------------------------------------------------------------------- feeds
# Feeds and article pages are fetched directly; this is only a fallback for
# hosts that refuse the connection outright (some publications are unreachable
# from a given network while answering fine through a proxy). Falls back to
# HTTPS_PROXY / HTTP_PROXY. Leave empty to never use one.
# FEED_PROXY_URL=http://proxy.lan:1080

# Configs to compare in `npm run llm-bench`; falls back to LLM_PROVIDERS.
# LLM_BENCH_PROVIDERS=ollama,groq
